{
  "root": "tags",
  "routes": [
    {
      "route": "/transfer/:_id",
      "modifying": false,
      "handlers": { "post": "transferHandler" },
      "permissions": { "post": ["write:content"] },
      "meta": {
        "post": {
          "summary": "Transfer tag",
          "description": "Transfers all items using one tag for another."
        }
      }
    }
  ]
}
